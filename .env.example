# Supabase project settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=
# Public URL of this app (Railway domain or your own), no trailing slash
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Optional, server only. Turns on AI alt text for uploaded images (console.anthropic.com)
ANTHROPIC_API_KEY=
# Optional, defaults to claude-sonnet-5
ANTHROPIC_MODEL=
# Auto-organise (optional): model for tagging, or 1 to switch it off
ANTHROPIC_TAG_MODEL=
DISABLE_AUTO_TAG=
# Optional, server only. Import from cloud drives (each source switches on when its keys are set).
# Dropbox Chooser: app key from dropbox.com/developers (add your app's domain under "Chooser / Saver / Embedder domains")
DROPBOX_APP_KEY=
# Google Picker: OAuth client ID (Web), API key, and project number (App ID), with the Drive API and Picker API enabled
GOOGLE_CLIENT_ID=
GOOGLE_API_KEY=
GOOGLE_APP_ID=
# Box: OAuth 2.0 app (User Authentication), redirect URI https://<your-app>/api/connect/box/callback, scope "Read all files and folders"
BOX_CLIENT_ID=
BOX_CLIENT_SECRET=

# AI search (Voyage embeddings)
VOYAGE_API_KEY=
VOYAGE_MODEL=

# Alerts and feedback emails (Resend). Without them, alerts and feedback are only logged / saved.
RESEND_API_KEY=
ALERT_EMAIL=you@yourcompany.com
# FEEDBACK_EMAIL=feedback@yourcompany.com   (defaults to ALERT_EMAIL)
# MAIL_FROM=Mise <hello@yourdomain>           (a sender on a domain verified in Resend)

# Fair-use ceilings for the "unlimited" things, per brand per month (defaults shown). Raise one brand in Supabase: workspaces.ai_caps = {"tag": 50000}
# Studio designs come from the plan (Free 20, Pro 200 then 50p each), not from these.
# AI_CAP_TAG=20000
# AI_CAP_SEARCH=10000
# AI_CAP_KIT=30

# Billing (Stripe). Run: STRIPE_SECRET_KEY=sk_test_… node scripts/stripe-setup.mjs  — it prints the price ids.
# Without STRIPE_SECRET_KEY and STRIPE_PRICE_PRO_MONTH, billing stays off and every brand is on Free.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO_MONTH=
STRIPE_PRICE_PRO_YEAR=
STRIPE_PRICE_OVERAGE_MONTH=
STRIPE_PRICE_OVERAGE_YEAR=
# STRIPE_METER_EVENT=studio_design
STRIPE_PORTAL_CONFIG=
# 1 to charge UK VAT with Stripe Tax (turn on Stripe Tax and add your VAT registration first)
STRIPE_TAX=
